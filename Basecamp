<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="theme-color" content="#0d1714" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="Basecamp" />
  <title>Basecamp — Celestial & Sylvan Sanctuary</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <style>
    :root {
      --bg-void: #09100e;
      --bg-forest: #0d1714;
      --bg-plum: #161321;
      --surface-card: rgba(21, 31, 28, 0.78);
      --surface-elevated: rgba(31, 45, 41, 0.85);
      --surface-plum: rgba(31, 26, 46, 0.78);
      --border-subtle: rgba(212, 184, 134, 0.16);
      --border-strong: rgba(212, 184, 134, 0.34);
      --text-primary: #f5efe6;
      --text-secondary: #c4bba8;
      --text-muted: #8a8478;
      --accent-gold: #dfbe84;
      --accent-gold-soft: rgba(223, 190, 132, 0.14);
      --accent-rose: #d99b96;
      --accent-rose-soft: rgba(217, 155, 150, 0.15);
      --accent-emerald: #6bc49c;
      --accent-emerald-soft: rgba(107, 196, 156, 0.14);
      --accent-lavender: #a99ce0;
      --accent-lavender-soft: rgba(169, 156, 224, 0.15);
      --accent-amber: #e3a857;
      --accent-amber-soft: rgba(227, 168, 87, 0.15);
      --radius-lg: 18px;
      --radius-md: 12px;
      --radius-sm: 8px;
      --shadow-card: 0 12px 32px rgba(0, 0, 0, 0.36);
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      background:
        radial-gradient(circle at 12% 8%, rgba(44, 33, 66, 0.55) 0%, transparent 42%),
        radial-gradient(circle at 88% 14%, rgba(26, 58, 48, 0.5) 0%, transparent 45%),
        linear-gradient(160deg, var(--bg-void) 0%, var(--bg-forest) 52%, var(--bg-plum) 100%);
      color: var(--text-primary);
      min-height: 100vh;
      line-height: 1.5;
      padding: env(safe-area-inset-top, 16px) 16px calc(40px + env(safe-area-inset-bottom, 0px));
      -webkit-font-smoothing: antialiased;
    }

    body.low-battery-mode {
      --border-subtle: rgba(169, 156, 224, 0.24);
      background:
        radial-gradient(circle at 20% 10%, rgba(56, 42, 82, 0.65) 0%, transparent 50%),
        linear-gradient(160deg, #0b0a12 0%, #13111d 60%, #101917 100%);
    }

    .app-shell { max-width: 1280px; margin: 0 auto; }

    h1, h2, h3, .serif {
      font-family: 'Cormorant Garamond', Georgia, serif;
      letter-spacing: 0.01em;
    }

    /* Header */
    .topbar {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 14px 20px;
      background: var(--surface-card);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      backdrop-filter: blur(14px);
      margin-bottom: 18px;
      box-shadow: var(--shadow-card);
    }

    .brand-group { display: flex; align-items: center; gap: 12px; }
    .brand-sigil {
      width: 40px; height: 40px; border-radius: 12px;
      background: linear-gradient(135deg, rgba(223, 190, 132, 0.22), rgba(217, 155, 150, 0.18));
      border: 1px solid var(--border-strong);
      display: grid; place-items: center;
      color: var(--accent-gold); font-size: 1.2rem;
    }
    .brand-title { font-size: 1.55rem; font-weight: 700; color: var(--accent-gold); line-height: 1.1; }
    .brand-sub { font-size: 0.76rem; color: var(--text-secondary); }

    .header-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }

    .pill-stat {
      display: inline-flex; align-items: center; gap: 6px;
      padding: 6px 12px; border-radius: 999px;
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid var(--border-subtle);
      font-size: 0.78rem; color: var(--text-secondary);
    }
    .pill-stat strong { color: var(--accent-gold); }

    /* Buttons & Badges */
    .btn {
      display: inline-flex; align-items: center; justify-content: center; gap: 6px;
      padding: 8px 14px; border-radius: var(--radius-sm);
      border: 1px solid var(--border-subtle);
      background: rgba(255, 255, 255, 0.05);
      color: var(--text-primary); font-family: inherit; font-size: 0.8rem; font-weight: 600;
      cursor: pointer; transition: all 0.18s ease;
    }
    .btn:hover { border-color: var(--border-strong); background: rgba(255, 255, 255, 0.09); }
    .btn-primary {
      background: linear-gradient(135deg, rgba(223, 190, 132, 0.24), rgba(217, 155, 150, 0.2));
      border-color: var(--border-strong); color: var(--accent-gold);
    }
